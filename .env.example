# ==========================================
# Kshirsa Technology Solutions — Environment Template
# ==========================================
# Copy this to .env for local development (never commit .env to git).
#
# For production deployment via GitHub Actions:
# Add RESEND_API_KEY as a GitHub Secret:
#   GitHub → Repo → Settings → Secrets and variables → Actions → New repository secret
# The workflow injects it as VITE_RESEND_API_KEY during npm run build.

VITE_RESEND_API_KEY=your_resend_api_key_here
