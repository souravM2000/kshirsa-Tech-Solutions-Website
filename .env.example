# ==========================================
# Kshirsa Technology Solutions - Environment Config
# ==========================================

# 1. Resend Email Configuration
# Sign up at https://resend.com and generate an API key (format: re_xxxxxxxxxxxx)
VITE_RESEND_API_KEY=

# 2. Resend Sender Email (Optional)
# In test mode without custom domain, Resend uses onboarding@resend.dev
# In production, use your verified domain e.g. info@yourdomain.com
VITE_RESEND_FROM_EMAIL=Kshirsa Inquiries <onboarding@resend.dev>

# 3. Destination Inquiries Inbox
VITE_CONTACT_RECEIVER_EMAIL=contact.kshirsatech@gmail.com

# 4. Optional Serverless / Backend Proxy Endpoint
# If you host a serverless function (Vercel, Cloudflare, Firebase, Express) to hide API keys:
# VITE_RESEND_API_ENDPOINT=https://your-api-domain.com/api/send-email
